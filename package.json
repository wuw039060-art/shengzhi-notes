{
  "name": "shengzhi-notes",
  "version": "0.2.17",
  "description": "声织笔记：把音视频转成适合 Obsidian 的 Markdown 知识笔记。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wuw039060-art/shengzhi-notes.git"
  },
  "homepage": "https://github.com/wuw039060-art/shengzhi-notes#readme",
  "bugs": {
    "url": "https://github.com/wuw039060-art/shengzhi-notes/issues"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "check": "node scripts/check.js",
    "check:release": "node scripts/check.js --release"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.shengzhi.notes",
    "productName": "声织笔记",
    "directories": {
      "output": "outputs/installers"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/icons/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
